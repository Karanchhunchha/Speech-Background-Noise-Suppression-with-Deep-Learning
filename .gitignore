# Downloaded corpus (large; fetched by download_data.m)
data/downloads/
data/voicebank/
data/training_patches.mat

# Generated outputs stay local, except the committed demo set
results/*
!results/demo/
!results/demo/**

# Only the shipped trained model is committed; backups stay local
models/*
!models/denoiseNet.mat

# Chunked-evaluation intermediates (canonical outputs are
# metrics_summary.csv, metrics_per_file.csv and EVALUATION.md)
reports/metrics_part*.csv
reports/metrics_summary_part*.csv
reports/EVALUATION_part*.md
reports/*_v1.*
# Exception: the v1 summary is kept as audit evidence for the
# model-selection comparison in FINAL_SUBMISSION_REPORT.md
!reports/metrics_summary_v1.csv
# Exception: the frozen pre-hardening baseline for before/after
# comparison in the submission-hardening work
!reports/baseline_v1.csv

# Listening-test working set (generated locally by make_listening_test)
listening_test/

# Enhanced clips exported for the offline PESQ script (large)
reports/enhanced_subset/

# MATLAB temporaries
*.asv
slprj/
sccprj/
